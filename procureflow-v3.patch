new file mode 100644
index 0000000..9649b25
--- /dev/null
+++ b/app/procureflow/voice-api.ts
@@ -0,0 +1,86 @@
+import { PendingApproval, ProposedAction, TenderContext } from "./voice-types";
+
+const API_BASE = process.env.NEXT_PUBLIC_PROCUREFLOW_API_BASE || "";
+
+export class ProcureFlowVoiceApi {
+  private token = "";
+
+  get configured() {
+    return Boolean(API_BASE);
+  }
+  get authenticated() {
+    return Boolean(this.token);
+  }
+
+  async authenticate(ownerAccessKey: string): Promise<void> {
+    if (!API_BASE)
+      throw new Error("NEXT_PUBLIC_PROCUREFLOW_API_BASE is not configured");
+    const response = await fetch(`${API_BASE}/api/v1/voice/session`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      credentials: "include",
+      body: JSON.stringify({ owner_access_key: ownerAccessKey }),
+    });
+    if (!response.ok) throw new Error("Owner authentication failed");
+    const body = await response.json();
+    if (!body.access_token)
+      throw new Error("Voice session token was not returned");
+    this.token = body.access_token;
+  }
+
+  private async request(path: string, init?: RequestInit) {
+    if (!this.token) throw new Error("Owner authentication is required");
+    const response = await fetch(`${API_BASE}${path}`, {
+      ...init,
+      credentials: "include",
+      headers: {
+        "Content-Type": "application/json",
+        Authorization: `Bearer ${this.token}`,
+        ...(init?.headers || {}),
+      },
+    });
+    if (!response.ok)
+      throw new Error(
+        (await response.text()) || `Request failed (${response.status})`,
+      );
+    return response.json();
+  }
+
+  getTenderContext(context: TenderContext) {
+    const query = new URLSearchParams({
+      company_id: context.companyId,
+      workspace: context.workspace,
+    });
+    return this.request(
+      `/api/v1/voice/tenders/${encodeURIComponent(
+        context.tenderId,
+      )}/context?${query}`,
+    );
+  }
+
+  async proposeAction(
+    context: TenderContext,
+    action: ProposedAction,
+  ): Promise<PendingApproval> {
+    const body = await this.request("/api/v1/voice/actions/propose", {
+      method: "POST",
+      body: JSON.stringify({ context, action }),
+    });
+    return {
+      actionId: body.action_id,
+      label: body.label,
+      action,
+      expiresAt: body.expires_at,
+    };
+  }
+
+  decideAction(actionId: string, decision: "approve" | "reject") {
+    return this.request(
+      `/api/v1/voice/actions/${encodeURIComponent(actionId)}/decision`,
+      {
+        method: "POST",
+        body: JSON.stringify({ decision }),
+      },
+    );
+  }
+}
diff --git a/app/procureflow/voice-policy.ts b/app/procureflow/voice-policy.ts
