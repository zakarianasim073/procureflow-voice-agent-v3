@@ -0,0 +1,337 @@
+"use client";
+
+import { useCallback, useContext, useMemo, useRef, useState } from "react";
+import { WebLLMContext } from "../context";
+import { useAppConfig } from "../store";
+import {
+  buildVoiceSystemPrompt,
+  parseVoiceModelResponse,
+} from "../procureflow/voice-policy";
+import { ProcureFlowVoiceApi } from "../procureflow/voice-api";
+import {
+  PendingApproval,
+  TenderContext,
+  VoiceLanguage,
+  VoiceModelResponse,
+} from "../procureflow/voice-types";
+import styles from "./voice-agent.module.scss";
+
+type Turn = {
+  role: "user" | "assistant";
+  text: string;
+  response?: VoiceModelResponse;
+};
+
+export function VoiceAgent() {
+  const webllm = useContext(WebLLMContext);
+  const config = useAppConfig();
+  const api = useMemo(() => new ProcureFlowVoiceApi(), []);
+  const [authenticated, setAuthenticated] = useState(false);
+  const [key, setKey] = useState("");
+  const [language, setLanguage] = useState<VoiceLanguage>("auto");
+  const [context, setContext] = useState<TenderContext>({
+    companyId: "",
+    companyName: "",
+    tenderId: "",
+    workspace: "tender",
+  });
+  const [trustedContext, setTrustedContext] = useState<unknown>({});
+  const [turns, setTurns] = useState<Turn[]>([]);
+  const [input, setInput] = useState("");
+  const [status, setStatus] = useState("Ready");
+  const [pending, setPending] = useState<PendingApproval | null>(null);
+  const recognition = useRef<any>(null);
+
+  const authenticate = async () => {
+    setStatus("Authenticating owner…");
+    try {
+      await api.authenticate(key);
+      setKey("");
+      setAuthenticated(true);
+      setStatus("Owner authenticated");
+    } catch (error) {
+      setStatus(
+        error instanceof Error ? error.message : "Authentication failed",
+      );
+    }
+  };
+
+  const loadContext = async () => {
+    if (!authenticated || !context.tenderId || !context.companyId)
+      return setStatus("Authenticate and select company + tender first");
+    setStatus("Loading trusted tender evidence…");
+    try {
+      setTrustedContext(await api.getTenderContext(context));
+      setStatus("Tender context ready");
+    } catch (error) {
+      setStatus(
+        error instanceof Error ? error.message : "Context loading failed",
+      );
+    }
+  };
+
+  const speak = useCallback(
+    (text: string) => {
+      if (!("speechSynthesis" in window)) return;
+      window.speechSynthesis.cancel();
+      const utterance = new SpeechSynthesisUtterance(text);
+      utterance.lang =
+        language === "bn" ||
+        (language === "auto" && /[\u0980-\u09ff]/.test(text))
+          ? "bn-BD"
+          : "en-US";
+      utterance.onstart = () => {
+        recognition.current?.abort();
+        setStatus("Speaking — tap Stop to interrupt");
+      };
+      utterance.onend = () => setStatus("Ready");
+      window.speechSynthesis.speak(utterance);
+    },
+    [language],
+  );
+
+  const ask = async (question: string) => {
+    if (!webllm || !question.trim()) return;
+    if (!authenticated) return setStatus("Owner authentication is required");
+    setTurns((old) => [...old, { role: "user", text: question }]);
+    setInput("");
+    setStatus("Running private in-browser analysis…");
+    const history = [...turns, { role: "user" as const, text: question }].slice(
+      -10,
+    );
+    await webllm.chat({
+      messages: [
+        {
+          role: "system",
+          content: buildVoiceSystemPrompt(context, trustedContext),
+        },
+        ...history.map((t) => ({ role: t.role, content: t.text })),
+      ],
+      config: {
+        ...config.modelConfig,
+        cache: config.cacheType,
+        stream: false,
+        enable_thinking: config.enableThinking,
+      },
+      onUpdate: (message) => setStatus(message),
+      onFinish: async (raw) => {
+        try {
+          const response = parseVoiceModelResponse(raw);
+          setTurns((old) => [
+            ...old,
+            { role: "assistant", text: response.spoken_response, response },
+          ]);
+          setStatus("Evidence-backed response ready");
+          speak(response.spoken_response);
+          if (response.proposed_actions[0])
+            setPending(
+              await api.proposeAction(context, response.proposed_actions[0]),
+            );
+        } catch (error) {
+          setStatus(
+            error instanceof Error
+              ? error.message
+              : "Unsafe model output was blocked",
+          );
+        }
+      },
+      onError: (error) => setStatus(String(error)),
+    });
+  };
+
+  const listen = () => {
+    const SpeechRecognition =
+      (window as any).SpeechRecognition ||
+      (window as any).webkitSpeechRecognition;
+    if (!SpeechRecognition)
+      return setStatus("Speech recognition is unavailable; type your question");
+    window.speechSynthesis?.cancel();
+    recognition.current?.abort();
+    const r = new SpeechRecognition();
+    recognition.current = r;
+    r.lang = language === "bn" ? "bn-BD" : "en-US";
+    r.interimResults = true;
+    r.continuous = false;
+    r.onstart = () => setStatus("Listening…");
+    r.onresult = (event: any) => {
+      let final = "";
+      for (let i = event.resultIndex; i < event.results.length; i++)
+        if (event.results[i].isFinal) final += event.results[i][0].transcript;
+      if (final) ask(final);
+    };
+    r.onerror = () => setStatus("Microphone failed; continue by typing");
+    r.start();
+  };
+
+  const decide = async (decision: "approve" | "reject") => {
+    if (!pending) return;
+    try {
+      await api.decideAction(pending.actionId, decision);
+      setPending(null);
+      setStatus(
+        decision === "approve"
+          ? "Owner-confirmed action submitted"
+          : "Action rejected",
+      );
+    } catch (error) {
+      setStatus(error instanceof Error ? error.message : "Decision failed");
+    }
+  };
+
+  return (
+    <main className={styles.shell}>
+      <header>
+        <div>
+          <b>ProcureFlow Voice Agent V3</b>
+          <span>Private WebLLM · Works procurement intelligence</span>
+        </div>
+        <em>{status}</em>
+      </header>
+      {!authenticated && (
+        <section className={styles.login}>
+          <h2>Owner authentication</h2>
+          <p>
+            Fail-closed: ProcureFlow server authentication is required before
+            tender data or actions are available.
+          </p>
+          {!api.configured && (
+            <strong>Configure NEXT_PUBLIC_PROCUREFLOW_API_BASE first.</strong>
+          )}
+          <div>
+            <input
+              type="password"
+              value={key}
+              onChange={(e) => setKey(e.target.value)}
+              placeholder="Owner access key"
+            />
+            <button onClick={authenticate} disabled={!api.configured || !key}>
+              Authenticate
+            </button>
+          </div>
+        </section>
+      )}
+      <div className={styles.grid}>
+        <section className={styles.chat}>
+          <div className={styles.controls}>
+            <select
+              value={language}
+              onChange={(e) => setLanguage(e.target.value as VoiceLanguage)}
+            >
+              <option value="auto">Auto language</option>
+              <option value="en">English</option>
+              <option value="bn">বাংলা</option>
+            </select>
+            <button onClick={listen}>🎤 Speak</button>
+            <button onClick={() => window.speechSynthesis?.cancel()}>
+              Stop voice
+            </button>
+          </div>
+          <div className={styles.turns}>
+            {turns.length === 0 && (
+              <p>
+                Ask about qualification, BOQ, pricing, competitors, PPR
+                compliance or evidence.
+              </p>
+            )}
+            {turns.map((turn, index) => (
+              <article
+                key={index}
+                className={turn.role === `user` ? styles.user : styles.agent}
+              >
+                <small>{turn.role}</small>
+                {turn.text}
+                {turn.response?.evidence.map((e, i) => (
+                  <cite key={i}>
+                    <b>{e.kind.replaceAll("_", " ")}</b> · {e.sourceTitle}
+                    {e.page ? ` · p.${e.page}` : ""}
+                    {e.confidence !== undefined
+                      ? ` · ${Math.round(e.confidence * 100)}%`
+                      : ""}
+                  </cite>
+                ))}
+              </article>
+            ))}
+          </div>
+          {pending && (
+            <div className={styles.approval}>
+              <b>Exact owner confirmation required</b>
+              <p>{pending.label}</p>
+              <code>{JSON.stringify(pending.action.arguments, null, 2)}</code>
+              <div>
+                <button onClick={() => decide("approve")}>
+                  Confirm action
+                </button>
+                <button onClick={() => decide("reject")}>Reject</button>
+              </div>
+            </div>
+          )}
+          <div className={styles.composer}>
+            <textarea
+              value={input}
+              onChange={(e) => setInput(e.target.value)}
+              placeholder="Ask ProcureFlow…"
+            />
+            <button
+              onClick={() => ask(input)}
+              disabled={!authenticated || !input.trim()}
+            >
+              Send
+            </button>
+          </div>
+        </section>
+        <aside>
+          <h3>Tender context</h3>
+          <input
+            value={context.companyId}
+            onChange={(e) =>
+              setContext({ ...context, companyId: e.target.value })
+            }
+            placeholder="Company ID"
+          />
+          <input
+            value={context.companyName}
+            onChange={(e) =>
+              setContext({ ...context, companyName: e.target.value })
+            }
+            placeholder="Company name"
+          />
+          <input
+            value={context.tenderId}
+            onChange={(e) =>
+              setContext({ ...context, tenderId: e.target.value })
+            }
+            placeholder="Tender ID"
+          />
+          <select
+            value={context.workspace}
+            onChange={(e) =>
+              setContext({
+                ...context,
+                workspace: e.target.value as TenderContext["workspace"],
+              })
+            }
+          >
+            <option value="opportunity">Opportunity</option>
+            <option value="tender">Tender workspace</option>
+            <option value="boq">BOQ</option>
+            <option value="pricing">Pricing</option>
+            <option value="ppr">PPR compliance</option>
+            <option value="evidence">Evidence center</option>
+          </select>
+          <button onClick={loadContext} disabled={!authenticated}>
+            Load verified context
+          </button>
+          <hr />
+          <h3>Trust boundary</h3>
+          <ul>
+            <li>Local WebGPU inference</li>
+            <li>Server-authorized evidence</li>
+            <li>Structured model output</li>
+            <li>One proposed action maximum</li>
+            <li>Explicit owner confirmation</li>
+          </ul>
+        </aside>
+      </div>
+    </main>
+  );
+}
